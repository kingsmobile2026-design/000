            HangulEngine.JONG_COMBINE[HangulEngine.JONG_OF[k[1]] * 100 + k[2]] = i
        end
    end
    for i = 0, 20 do
        local k = HangulEngine.JUNG_KEYS[i]
        if #k == 2 then
            HangulEngine.JUNG_COMBINE[HangulEngine.JUNG_OF[k[1]] * 1000 + k[2]] = i
        end
    end
end

function HangulEngine.wordToKeys(word)
    local keys = {}
    for _, cp in utf8.codes(word) do
        if cp >= HangulEngine.SBASE and cp < HangulEngine.SBASE + HangulEngine.SCOUNT then
            local s = cp - HangulEngine.SBASE
            keys[#keys+1] = HangulEngine.CHO[math.floor(s / HangulEngine.NCOUNT) + 1]
            for _, k in ipairs(HangulEngine.JUNG_KEYS[math.floor((s % HangulEngine.NCOUNT) / HangulEngine.TCOUNT)]) do
                keys[#keys+1] = k
            end
            local t = s % HangulEngine.TCOUNT
            if t > 0 then
                for _, k in ipairs(HangulEngine.JONG_KEYS[t]) do keys[#keys+1] = k end
            end
        else
            keys[#keys+1] = cp
        end
    end
    return keys
end

function HangulEngine.render(committed, cho, jung, jong)
    if cho and jung then
        return committed .. utf8.char(HangulEngine.SBASE + (cho * HangulEngine.VCOUNT + jung) * HangulEngine.TCOUNT + jong)
    elseif cho then
        return committed .. utf8.char(HangulEngine.CHO[cho+1])
    elseif jung then
        return committed .. utf8.char(HangulEngine.JUNG[jung+1])
    end
    return committed
end

function HangulEngine.buildTypeStates(word)
    local keys = HangulEngine.wordToKeys(word)
    local states, committed = {}, ""
    local cho, jung, jong = nil, nil, 0
    
    local function commit()
        committed = HangulEngine.render(committed, cho, jung, jong)
        cho, jung, jong = nil, nil, 0
    end
    
    for _, cp in ipairs(keys) do
        if HangulEngine.CHO_OF[cp] then
            if cho and jung then
                if jong == 0 and HangulEngine.JONG_OF[cp] then
                    jong = HangulEngine.JONG_OF[cp]
                elseif jong > 0 and HangulEngine.JONG_COMBINE[jong * 100 + cp] then
                    jong = HangulEngine.JONG_COMBINE[jong * 100 + cp]
                else
                    commit()
                    cho = HangulEngine.CHO_OF[cp]
                end
            elseif cho then
                commit()
                cho = HangulEngine.CHO_OF[cp]
            else
                cho = HangulEngine.CHO_OF[cp]
            end
        elseif HangulEngine.JUNG_OF[cp] then
            if jong > 0 then
                local kt = HangulEngine.JONG_KEYS[jong]
                if #kt == 2 then
                    jong = HangulEngine.JONG_OF[kt[1]]
                    commit()
                    cho = HangulEngine.CHO_OF[kt[2]]
                    jung = HangulEngine.JUNG_OF[cp]
                else
                    jong = 0
                    commit()
                    cho = HangulEngine.CHO_OF[kt[1]]
                    jung = HangulEngine.JUNG_OF[cp]
                end
            elseif cho and jung then
                local comb = HangulEngine.JUNG_COMBINE[jung * 1000 + cp]
                if comb then jung = comb else commit() jung = HangulEngine.JUNG_OF[cp] end
            elseif jung then
                local comb = HangulEngine.JUNG_COMBINE[jung * 1000 + cp]
                if comb then jung = comb else commit() jung = HangulEngine.JUNG_OF[cp] end
            else
                jung = HangulEngine.JUNG_OF[cp]
            end
        else
            commit()
            committed = committed .. utf8.char(cp)
        end
        states[#states+1] = HangulEngine.render(committed, cho, jung, jong)
    end
    
    local out = {}
    for _, s in ipairs(states) do
        if out[#out] ~= s then out[#out+1] = s end
    end
    if #out == 0 or out[#out] ~= word then out[#out+1] = word end
    return out
end

