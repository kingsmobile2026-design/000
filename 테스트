function AutomationManager.findGameTextBox()
    local plGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not plGui then return nil end
    local gg = plGui:FindFirstChild("GameGui")
    local box = gg and gg:FindFirstChild("TriesFrame") and gg.TriesFrame:FindFirstChild("TypeFrame") and gg.TriesFrame.TypeFrame:FindFirstChild("TextBox")
    
    if box and box:IsA("TextBox") then
        pcall(function()
            box.Visible = true; box.Active = true; box.Selectable = true; box.Interactable = true
            if box.Parent then box.Parent.Visible = true end
        end)
        return box
    end
    
    for _, v in ipairs(plGui:GetDescendants()) do
        if v:IsA("TextBox") then
            if v.Name == "TextBox" or v.Name == "InputText" or (v.Parent and v.Parent.Name == "TypeFrame") then
                pcall(function()
                    v.Visible = true; v.Active = true; v.Selectable = true; v.Interactable = true
                    if v.Parent then v.Parent.Visible = true end
                end)
                return v
            end
        end
    end
    return nil
end

function AutomationManager.checkGameTextBoxIsActive()
    local plGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not plGui then return nil end
    local gg = plGui:FindFirstChild("GameGui")
    local box = gg and gg:FindFirstChild("TriesFrame") and gg.TriesFrame:FindFirstChild("TypeFrame") and gg.TriesFrame.TypeFrame:FindFirstChild("TextBox")

    if box and box:IsA("TextBox") and box.Visible and box.TextTransparency < 1 and box.Parent and box.Parent.Visible then
        return box
    end
    for _, v in ipairs(plGui:GetDescendants()) do
        if v:IsA("TextBox") and v.Visible and v.TextTransparency < 1 and (v.Parent and v.Parent.Visible) then
            if v.Name == "TextBox" or v.Name == "InputText" or v.Parent.Name == "TypeFrame" then
                return v
            end
        end
    end
    return nil
end

function AutomationManager.sendWordToGame(word, explicitBox)
    if word == "" then return end

    local targetBox = explicitBox or AutomationManager.findGameTextBox()
    if not targetBox then return end

    AutomationManager.CurrentTypeSession = AutomationManager.CurrentTypeSession + 1
    local mySession = AutomationManager.CurrentTypeSession
    
    local speed = CONFIG.DEFAULT_TYPING_SPEED
    if InterfaceManager.SpeedInput then
        speed = tonumber(InterfaceManager.SpeedInput.Text) or CONFIG.DEFAULT_TYPING_SPEED
    end

    pcall(function()
        targetBox.Text = ""
        targetBox:CaptureFocus()

        if speed <= 0 then
            if mySession ~= AutomationManager.CurrentTypeSession then return end
            targetBox.Text = word
        else
            local totalStates = HangulEngine.buildTypeStates(word)
            local delayTime = 60 / (speed * 2.5)
            for _, partialText in ipairs(totalStates) do
                if mySession ~= AutomationManager.CurrentTypeSession then return end
                targetBox.Text = partialText
                task.wait(delayTime)
            end
        end

        if mySession ~= AutomationManager.CurrentTypeSession then return end
        task.wait(0.01)
        targetBox:ReleaseFocus(true)

        if SecurityManager.AntiCheatActive and SecurityManager.isUserPremium() then
            task.wait(CONFIG.ANTI_CHEAT_POST_WAIT)
            if mySession == AutomationManager.CurrentTypeSession then
                targetBox.Text = ""
                MemoryManager.optimize()
            end
        end
    end)
end

function AutomationManager.runChatSpam(msg, count)
    if msg == "" then return end
    task.spawn(function()
        for _ = 1, count do
            local sent = false
            if Services.TextChatService and Services.TextChatService.ChatInputBarConfiguration then
                local currentChannel = Services.TextChatService.ChatInputBarConfiguration.TargetTextChannel
                if currentChannel then
                    currentChannel:SendAsync(msg)
                    sent = true
                end
            end
            if not sent then
                local sayMessage = Services.ReplicatedStorage:FindFirstChild("SayMessageRequest", true) or 
                                   (Services.ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents") and 
                                   Services.ReplicatedStorage.DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest"))
                if sayMessage and sayMessage:IsA("RemoteEvent") then
                    sayMessage:FireServer(msg, "All")
                else
                    local chatBar = LocalPlayer.PlayerGui:FindFirstChild("Chat") and 
                                     LocalPlayer.PlayerGui.Chat:FindFirstChild("Frame") and 
                                     LocalPlayer.PlayerGui.Chat.Frame:FindFirstChild("ChatBarParentFrame")
                    local realBar = chatBar and chatBar:FindFirstChild("Frame") and 
                                     chatBar.Frame:FindFirstChild("BoxFrame") and 
                                     chatBar.Frame.BoxFrame:FindFirstChild("ChatBar")
                    if realBar and realBar:IsA("TextBox") then
                        realBar:CaptureFocus() 
                        realBar.Text = msg 
                        task.wait(0.05) 
                        realBar:ReleaseFocus(true)
                    end
                end
            end
            task.wait(0.5)
        end
    end)
end

function AutomationManager.runGameSpam(msg, count)
    if msg == "" then return end
    local targetBox = AutomationManager.findGameTextBox()
    if not targetBox then return end

    task.spawn(function()
        pcall(function()
            targetBox:CaptureFocus()
            for _ = 1, count do
                local totalStates = HangulEngine.buildTypeStates(msg)
                for _, partialText in ipairs(totalStates) do 
                    targetBox.Text = partialText 
                    task.wait(0.01) 
                end
                task.wait(0.4) 
                targetBox.Text = "" 
                task.wait(0.3)
            end
            targetBox.Text = "" 
            targetBox:ReleaseFocus(false) 
            MemoryManager.optimize()
        end)
    end)
end

function AutomationManager.runEmergencySpam()
    local targetBox = AutomationManager.findGameTextBox()
    if not targetBox then return end
    task.spawn(function()
        for _ = 1, CONFIG.EMERGENCY_SPAM_COUNT do
            pcall(function()
                targetBox.Text = "" 
                targetBox:CaptureFocus() 
                targetBox.Text = "ㄴ" 
                task.wait(0.01) 
                targetBox:ReleaseFocus(true)
            end)
            task.wait(CONFIG.EMERGENCY_SPAM_INTERVAL)
        end
        MemoryManager.optimize()
    end)
end

