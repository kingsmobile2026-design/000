    CustomKillLetters = {["륨"] = true, ["늄"] = true, ["뮴"] = true, ["튬"] = true, ["킷"] = true, ["꾼"] = true, ["녘"] = true, ["렆"] = true, ["졈"] = true, ["젶"] = true, ["팎"] = true},
