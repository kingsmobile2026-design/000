    AllowedYaChoseong = { [0] = true, [3] = true, [2] = true, [5] = true, [6] = true, [9] = true, [12] = true, [14] = true, [15] = true, [16] = true, [17] = true, [18] = true },
    DoubleChoseongIndex = { [1] = true, [4] = true, [8] = true, [10] = true, [13] = true },
    EndingKillLetters = {},
    FirstTurnFlag = true
}

function StrategicCore.initialize()
    for _, v in ipairs(StrategicCore.SpecialWords) do StrategicCore.EndingKillLetters[v] = true end
end

function StrategicCore.getLastChar(word)
    if word == "" then return "" end
    local successOffset, offset = pcall(function() return utf8.offset(word, utf8.len(word)) end)
    if not successOffset or not offset then return "" end
    return string.sub(word, offset)
end

function StrategicCore.getCompatibleChars(char)
    if Database.DUEUM and Database.DUEUM[char] then
        if type(Database.DUEUM[char]) == "table" then
            local res = {char}
            for _, v in ipairs(Database.DUEUM[char]) do table.insert(res, v) end
            return res
        else return {char, Database.DUEUM[char]} end
    end
    return {char}
end

function StrategicCore.getWordCountStartingWith(char)
    local count = 0
    if Database.DICT[char] then count = count + #Database.DICT[char] end
    if Database.DUEUM[char] then
        local alts = type(Database.DUEUM[char]) == "table" and Database.DUEUM[char] or {Database.DUEUM[char]}
        for _, alt in ipairs(alts) do if Database.DICT[alt] then count = count + #Database.DICT[alt] end end
    end
    return count
end

function StrategicCore.hasKillWordStartingWith(char)
    local checkChars = {char}
    if Database.DUEUM[char] then
        if type(Database.DUEUM[char]) == "table" then for _, v in ipairs(Database.DUEUM[char]) do table.insert(checkChars, v) end
        else table.insert(checkChars, Database.DUEUM[char]) end
    end
    for _, c in ipairs(checkChars) do
        if Database.DICT[c] then
            for _, word in ipairs(Database.DICT[c]) do
                local successOffset, offset = pcall(function() return utf8.offset(word, utf8.len(word)) end)
                if successOffset and offset then
                    local last = string.sub(word, offset)
                    if StrategicCore.EndingKillLetters[last] or StrategicCore.CustomKillLetters[last] then return true end
                end
            end
        end
    end
    return false
end

function StrategicCore.checkIsKillWord(word)
    if word == "" then return false end
    local lastChar = StrategicCore.getLastChar(word)
    if lastChar == "" then return false end
    if StrategicCore.EndingKillLetters[lastChar] or StrategicCore.CustomKillLetters[lastChar] then return true end
    local code = utf8.codepoint(lastChar)
    if code >= 0xAC00 and code <= 0xD7A3 then
        local hangulIndex = code - 0xAC00
        local jongsei = hangulIndex % 28
        local jungseong = math.floor((hangulIndex % 588) / 28)
        local choseong = math.floor(hangulIndex / 588)
        if StrategicCore.DoubleChoseongIndex[choseong] and jongsei > 0 then return true end
        if StrategicCore.DoubleJongseiIndex[jongsei] or StrategicCore.TargetJongseiIndex[jongsei] then return true end
        if jungseong == 13 or jungseong == 9 then return true end
        if jungseong == 6 and StrategicCore.AllowedYeoChoseong[choseong] then return true end
        if jungseong == 2 and StrategicCore.AllowedYaChoseong[choseong] then return true end
    end
    return false
end

function StrategicCore.checkIsPerfectDefenseWord(word)
    local lastChar = StrategicCore.getLastChar(word)
    if lastChar == "" then return false end
    local totalWords = StrategicCore.getWordCountStartingWith(lastChar)
    local hasKill = StrategicCore.hasKillWordStartingWith(lastChar)
    if not hasKill or totalWords <= 5 then return true end
    return false
end

function StrategicCore.checkIsPerfectKillWord(word)
    local lastChar = StrategicCore.getLastChar(word)
    if lastChar == "" then return false end
    if StrategicCore.getWordCountStartingWith(lastChar) == 0 then return true end
    return false
end

function StrategicCore.checkIsChobanWord(word)
    if word == "" then return false end
    local lastChar = StrategicCore.getLastChar(word)
    return StrategicCore.ChobanEndingLetters[lastChar] or false
end

function StrategicCore.checkIsUltraLongWord(word)
    return utf8.len(word) >= 5
end

