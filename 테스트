-- 신규 구현: 완벽 방어단어 & 완벽 한방단어 & 첫 턴 판별 시스템
-- ==========================================

-- 특정 글자로 시작하는 데이터베이스 내 단어 필터링 헬퍼 함수
local function getWordsStartingWith(char)
    local list = {}
    for _, word in ipairs(WordDB) do
        local successOffset, offset = pcall(function() return utf8.offset(word, 2) - 1 end)
        if successOffset and offset then
            if string.sub(word, 1, offset) == char then
                table.insert(list, word)
            end
        end
    end
    return list
end

-- 단어 리스트 중 한방 단어가 포함되어 있는지 확인하는 함수
local function hasKillWordInList(wordList)
    for _, w in ipairs(wordList) do
        if checkIsKillWord(w) then
            return true
        end
    end
    return false
end

-- 단어 유형 상세 구별 함수
local function getWordType(word)
    if word == "" then return "일반" end
    
    local successOffset, offset = pcall(function() return utf8.offset(word, utf8.len(word)) end)
    if not successOffset or not offset then return "일반" end
    local lastChar = string.sub(word, offset)
    
    -- 끝 글자로 상대방이 이어받을 수 있는 단어 조회
    local nextWords = getWordsStartingWith(lastChar)
    
    -- 1. 완벽 한방단어: 상대방이 이어갈 단어가 아예 존재하지 않는 경우
    if #nextWords == 0 then
        return "완벽한방"
    end
    
    -- 2. 완벽 방어단어: 이어갈 단어 중 한방단어가 없거나, 총 단어 수가 5개 이하인 경우
    if not hasKillWordInList(nextWords) or #nextWords <= 5 then
        return "완벽방어"
    end
    
    -- 3. 기존의 일반 한방단어 기준 확인
    if checkIsKillWord(word) then
        return "한방"
    end
    
    return "일반"
end

-- 게임 내에서 현재가 '첫 공격 턴'인지 식별하는 함수
local function isFirstTurnOfGame()
    -- 시간 초가 극초반이거나 라운드 데이터 조건 확인
    local currentTime = findTurnTime and findTurnTime() or 0
    if type(currentTime) == "number" and currentTime > 49 then 
        return true
    end
    
    -- UI 텍스트 정보를 수집하여 판별 보강 가능
    local targetLabel = findSpectatorLabel and findSpectatorLabel()
    if targetLabel and (string.find(targetLabel.Text, "시작") or string.find(targetLabel.Text, "첫")) then
        return true
    end
    
    return false
end

-- 조건 분석 기반 최적의 단어 추출 함수 (첫 턴 제어 적용)
local function getBestWordForChar(startingLetter)
    local allMatchedWords = {}
    local chars = getCompatibleChars(startingLetter)
    
    for _, word in ipairs(WordDB) do
        local successOffset, offset = pcall(function() return utf8.offset(word, 2) - 1 end)
        if successOffset and offset then
            local firstChar = string.sub(word, 1, offset)
            local matched = false
            for _, c in ipairs(chars) do
                if firstChar == c then matched = true break end
            end
            
            if matched then
                local wType = getWordType(word)
                table.insert(allMatchedWords, {word = word, type = wType})
            end
        end
    end
    
    if #allMatchedWords == 0 then return nil end
    
    -- 첫 턴(첫 공격) 감지 여부
    local isFirst = isFirstTurnOfGame()
    
    -- 첫 턴인 경우: 방어단어(완벽방어 또는 일반 단어) 군집 안에서만 선택하도록 제한
    if isFirst then
        local defenseWords = {}
        for _, item in ipairs(allMatchedWords) do
            if item.type == "완벽방어" or item.type == "일반" then
                table.insert(defenseWords, item.word)
            end
        end
        if #defenseWords > 0 then
            -- 방어 단어가 있다면 긴 단어 순서로 정렬 후 최선의 방어 단어를 선택
            table.sort(defenseWords, function(a, b) return utf8.len(a) > utf8.len(b) end)
            return defenseWords[1]
        end
    end
    
    -- 일반적인 턴 구조일 때 우선순위 공격 체인 (완벽한방 -> 한방 -> 완벽방어 -> 일반)
    -- 1순위: 완벽한방 단어 탐색
    for _, item in ipairs(allMatchedWords) do
        if item.type == "완벽한방" then return item.word end
    end
    -- 2순위: 일반 한방 단어 탐색
    for _, item in ipairs(allMatchedWords) do
        if item.type == "한방" then return item.word end
    end
    -- 3순위: 완벽방어 단어 탐색
    for _, item in ipairs(allMatchedWords) do
        if item.type == "완벽방어" then return item.word end
    end
    
    -- 글자 수가 가장 긴 단어를 기본 반환하도록 세팅
    table.sort(allMatchedWords, function(a, b) return utf8.len(a.word) > utf8.len(b.word) end)
    return allMatchedWords[1].word
end

