-- =======================================================================
-- [첫 턴 감지 및 관리 시스템 통합본]
-- =======================================================================
local FirstTurnManager = {}

-- ─── [내부 상태 변수들] ──────────────────────────────────────────────
FirstTurnManager.roundFirstTurn = true   -- 현재 라운드가 첫 턴인지 여부
FirstTurnManager.roundStartLetter = nil  -- 라운드가 시작될 때의 첫 제시어

-- ─── [의존성 헬퍼 함수] ──────────────────────────────────────────────
-- 두 글자가 두음법칙 등을 고려하여 서로 호환되는지 판별 (원래 코드 기준)
local function lettersCompatible(a, b)
    if type(a) ~= "string" or type(b) ~= "string" or a == "" or b == "" then return false end
    -- 본래 스크립트의 syllableKeys/DUEUM 구조를 기반으로 작동함
    -- 여기서는 단순화를 위해 기본 문자열 비교를 수행하며, 실제 적용 시 기존 syllableKeys 함수를 활용하세요.
    return a == b
end

-- 단어의 첫 음절(3바이트) 추출
local function firstSyllable(text)
    if type(text) ~= "string" or #text < 3 then return tostring(text or "") end
    return text:sub(1, 3)
end

-- ─── [핵심 기능 함수들] ──────────────────────────────────────────────

--- 1. 현재 첫 턴 상태이거나 한방 단어를 방지해야 하는 상황인지 판별
function FirstTurnManager.shouldAvoidOneShot(bAvoidOneShotWordsSetting)
    -- 외부 설정(한방 방지 옵션)이 켜져 있거나, '현재가 첫 턴' 상태라면 true를 반환
    return bAvoidOneShotWordsSetting or FirstTurnManager.roundFirstTurn
end

--- 2. 새로운 라운드/목숨 세션이 시작되어 첫 턴 상태로 리셋
function FirstTurnManager.resetToFirstTurn(startingLetter)
    FirstTurnManager.roundFirstTurn = true
    FirstTurnManager.roundStartLetter = startingLetter
    print("[FirstTurn] 라운드가 첫 턴 상태로 리셋되었습니다. 제시어:", startingLetter)
end

--- 3. 단어가 성공적으로 제출되었을 때 호출하여 첫 턴 상태를 해제
function FirstTurnManager.onWordAccepted(word)
    if FirstTurnManager.roundFirstTurn then
        FirstTurnManager.roundFirstTurn = false
        print("[FirstTurn] 단어 승인으로 인해 첫 턴 상태가 해제되었습니다. (제출 단어: " .. tostring(word) .. ")")
    end
end

--- 4. 특정 단어 패킷이 들어왔을 때, 이것이 진짜 이번 첫 턴에 유효한 단어인지 판별
function FirstTurnManager.isCurrentRoundWordPayload(word, currentStartingLetter)
    -- 이미 진행 중인 라운드라면 무조건 유효(true)로 판정
    if not FirstTurnManager.roundFirstTurn then return true end
    
    local letter = currentStartingLetter or FirstTurnManager.roundStartLetter
    if not letter then return true end
    
    -- 단어의 첫 글자가 현재 제시어와 일치하는지 감지
    if lettersCompatible(firstSyllable(word), letter) then return true end
    
    -- 서버 패킷 레이스로 인해 제시어가 이미 바뀐 경우, 단어의 끝 글자가 제시어와 호환되는지 감지
    return lettersCompatible(word:sub(-3), letter)
end

--- 5. 서버 거부 메시지를 분석하여 '첫 턴 한방 제한'에 걸린 것인지 감지
function FirstTurnManager.isFirstTurnOneShotText(serverReasonText)
    if type(serverReasonText) ~= "string" then return false end
    
    -- 서버 에러 문구에 "첫 턴"과 "한방"이 모두 포함되어 있는지 판별
    local hasFirstTurn = string.find(serverReasonText, "첫 턴", 1, true) ~= nil
    local hasOneShot = string.find(serverReasonText, "한방", 1, true) ~= nil
    
    return hasFirstTurn and hasOneShot
end


