        local successFlux, resFlux = pcall(function() return Fluxus and Fluxus.request or nil end)
        if successFlux and type(resFlux) == "function" then return resFlux end
        
        return nil
    end
    RequestEngine = evaluateRequestFunction()
end

function NetworkManager.download(url)
    if not RequestEngine then
        Logger.warn("Executor does not support HTTP requests via native bridges.")
        return nil
    end
    
    local success, response = pcall(RequestEngine, {
        Url = url,
        Method = "GET"
    })
    
    if success and response and response.StatusCode == 200 then
        return response.Body
    end
    Logger.warn("Failed to fetch data from URL: " .. tostring(url))
    return nil
end

