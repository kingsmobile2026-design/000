function InterfaceManager.updateUIList(searchText)
    local scroll = InterfaceManager.ScrollFrame
    local layout = InterfaceManager.ListLayout
    local scale = InterfaceManager.UIScaleFactor
    if not scroll or not layout then return end

    for _, child in ipairs(scroll:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
    if searchText == "" then return end
    
    local firstChar = string.sub(searchText, 1, math.max(1, utf8.offset(searchText, 2) and utf8.offset(searchText, 2)-1 or #searchText))
    local compChars = StrategicCore.getCompatibleChars(firstChar)
    
    local matchedWords = {}
    for _, c in ipairs(compChars) do
        if Database.DICT[c] then
            for _, word in ipairs(Database.DICT[c]) do
                if string.sub(word, 1, #searchText) == searchText or searchText == c then
                    table.insert(matchedWords, word)
                end
            end
        end
    end
    
    table.sort(matchedWords, function(a, b)
        local priorityA = 0
        local priorityB = 0
        
        if StrategicCore.FirstTurnFlag then
            if StrategicCore.checkIsChobanWord(a) or StrategicCore.checkIsPerfectDefenseWord(a) then priorityA = priorityA + 100 end
            if StrategicCore.checkIsChobanWord(b) or StrategicCore.checkIsPerfectDefenseWord(b) then priorityB = priorityB + 100 end
        end
        
        if StrategicCore.checkIsUltraLongWord(a) then priorityA = priorityA + 50 end
        if StrategicCore.checkIsUltraLongWord(b) then priorityB = priorityB + 50 end
        
        if StrategicCore.checkIsPerfectKillWord(a) then priorityA = priorityA + 40
        elseif StrategicCore.checkIsKillWord(a) then priorityA = priorityA + 30
        elseif StrategicCore.checkIsPerfectDefenseWord(a) then priorityA = priorityA + 20
        elseif StrategicCore.checkIsChobanWord(a) then priorityA = priorityA + 10 end
        
        if StrategicCore.checkIsPerfectKillWord(b) then priorityB = priorityB + 40
        elseif StrategicCore.checkIsKillWord(b) then priorityB = priorityB + 30
        elseif StrategicCore.checkIsPerfectDefenseWord(b) then priorityB = priorityB + 20
        elseif StrategicCore.checkIsChobanWord(b) then priorityB = priorityB + 10 end
        
        if priorityA ~= priorityB then
            return priorityA > priorityB
        else
            return utf8.len(a) > utf8.len(b)
        end
    end)
    
    for _, word in ipairs(matchedWords) do
        local displayTag = ""
        local itemColor = Color3.fromRGB(220, 220, 220)
        
        if StrategicCore.checkIsUltraLongWord(word) then
            displayTag = " 🚀 [초장문]"
            itemColor = Color3.fromRGB(255, 170, 0)
        elseif StrategicCore.checkIsPerfectKillWord(word) then
            displayTag = " 💀 [완벽한방]"
            itemColor = Color3.fromRGB(255, 60, 60)
        elseif StrategicCore.checkIsKillWord(word) then
            displayTag = " 🩸 [한방]"
            itemColor = Color3.fromRGB(255, 110, 110)
        elseif StrategicCore.checkIsPerfectDefenseWord(word) then
            displayTag = " 🛡️ [완벽방어]"
            itemColor = Color3.fromRGB(80, 190, 255)
        elseif StrategicCore.checkIsChobanWord(word) then
            displayTag = " 🍀 [방어/초반]"
            itemColor = Color3.fromRGB(0, 255, 150)
        end
        
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 22 * scale)
        btn.BackgroundColor3 = Color3.fromRGB(34, 34, 38)
        btn.Text = "  " .. word .. displayTag
        btn.TextColor3 = itemColor
        btn.Font = Enum.Font.SourceSansBold
        btn.TextSize = math.round(11 * scale)
        btn.TextXAlignment = Enum.TextXAlignment.Left
        createRounding(btn, 4 * scale)
        btn.Parent = scroll
        
        btn.MouseButton1Click:Connect(function() AutomationManager.sendWordToGame(word) end)
    end
    scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
end

