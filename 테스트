lock.Font = Enum.Font.SourceSansBold
lock.TextSize = math.round(10 * uiScale)
lock.LayoutOrder = 999999
Instance.new("UICorner", lock)
end

scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + (4 * uiScale))
return isUserPremium and totalCount or visibleCount
end

