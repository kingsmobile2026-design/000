local StrategyExecutionLoop = {}

function StrategyExecutionLoop.begin()
    task.spawn(function()
        while true do
            task.wait(CONFIG.AI_LOOP_INTERVAL)
            if SecurityManager.BotAiActive and SecurityManager.isUserPremium() then
                local activeBox = AutomationManager.checkGameTextBoxIsActive()
                if activeBox then
                    local currentGameText = activeBox.Text
                    if currentGameText ~= "" then
                        local firstChar = string.sub(currentGameText, 1, 3)
                        local compChars = StrategicCore.getCompatibleChars(firstChar)
                        local pool = {}
                        
                        for _, c in ipairs(compChars) do
                            if Database.DICT[c] then
                                for _, word in ipairs(Database.DICT[c]) do
                                    table.insert(pool, word)
                                end
                            end
                        end
                        
                        if #pool > 0 then
                            local selectedWord = nil
                            if StrategicCore.checkIsFirstTurn() then
                                local defensePool = {}
                                for _, word in ipairs(pool) do
                                    if StrategicCore.checkIsPerfectDefenseWord(word) or StrategicCore.checkIsChobanWord(word) then
                                        table.insert(defensePool, word)
                                    end
                                end
                                if #defensePool > 0 then
                                    selectedWord = defensePool[math.random(1, #defensePool)]
                                else
                                    selectedWord = pool[math.random(1, #pool)]
                                end
                            else
                                table.sort(pool, function(a, b)
                                    local scoreA = StrategicCore.checkIsPerfectKillWord(a) and 4 or (StrategicCore.checkIsKillWord(a) and 3 or (StrategicCore.checkIsPerfectDefenseWord(a) and 2 or 1))
                                    local scoreB = StrategicCore.checkIsPerfectKillWord(b) and 4 or (StrategicCore.checkIsKillWord(b) and 3 or (StrategicCore.checkIsPerfectDefenseWord(b) and 2 or 1))
                                    return scoreA > scoreB
                                end)
                                selectedWord = pool[1]
                            end
                            
                            if selectedWord then
                                AutomationManager.sendWordToGame(selectedWord, activeBox)
                                SecurityManager.TurnToken = SecurityManager.TurnToken + 1
                                task.wait(CONFIG.AI_WORD_POST_WAIT)
                            end
                        end
                    end
                end
            end
        end
    end)
end

