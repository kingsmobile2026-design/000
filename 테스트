local function sendWordToGame(word, explicitBox)
if word == "" then return end
local targetBox = explicitBox or findGameTextBox()
if not targetBox then return end
currentTypeSession = currentTypeSession + 1
local mySession = currentTypeSession
local speed = tonumber(speedInputBox.Text) or 400
pcall(function()
targetBox.Text = ""
targetBox:CaptureFocus()
if speed <= 0 then
if mySession ~= currentTypeSession then return end
targetBox.Text = word
else
local totalStates = buildTypeStates(word)
local delayTime = 60 / (speed * 2.5)
for _, partialText in ipairs(totalStates) do
if mySession ~= currentTypeSession then return end
targetBox.Text = partialText
task.wait(delayTime)
end
end
if mySession ~= currentTypeSession then return end
task.wait(0.01)
targetBox:ReleaseFocus(_T)
if antiCheatActive and isUserPremium then
task.wait(0.08)
if mySession == currentTypeSession then
targetBox.Text = ""
collectgarbage("collect")
end
end
end)
end

