function AutomationManager.forceInvokeTextBox()
    local plGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not plGui then return nil end
    local gg = plGui:FindFirstChild("GameGui")
    
    local targetBox = gg and gg:FindFirstChild("TriesFrame") and gg.TriesFrame:FindFirstChild("TypeFrame") and gg.TriesFrame.TypeFrame:FindFirstChild("TextBox")
    if targetBox and targetBox:IsA("TextBox") then
        pcall(function()
            targetBox.Visible = true
            targetBox.Active = true
            targetBox.Selectable = true
            targetBox.Interactable = true
            targetBox.TextTransparency = 0
            if targetBox.Parent then 
                targetBox.Parent.Visible = true 
                targetBox.Parent.BackgroundTransparency = 0
            end
        end)
        return targetBox
    end
    
    for _, v in ipairs(plGui:GetDescendants()) do
        if v:IsA("TextBox") then
            if v.Name == "TextBox" or v.Name == "InputText" or (v.Parent and v.Parent.Name == "TypeFrame") then
                pcall(function()
                    v.Visible = true
                    v.Active = true
                    v.Selectable = true
                    v.Interactable = true
                    v.TextTransparency = 0
                    if v.Parent then 
                        v.Parent.Visible = true 
                    end
                end)
                return v
            end
        end
    end
    
    if gg then
        local triesFrame = gg:FindFirstChild("TriesFrame")
        if triesFrame then
            local typeFrame = triesFrame:FindFirstChild("TypeFrame")
            if not typeFrame then
                typeFrame = Instance.new("Frame")
                typeFrame.Name = "TypeFrame"
                typeFrame.Size = UDim2.new(1, 0, 0, 40)
                typeFrame.Position = UDim2.new(0, 0, 1, -40)
                typeFrame.BackgroundTransparency = 0
                typeFrame.Visible = true
                typeFrame.Parent = triesFrame
            end
            local newBox = typeFrame:FindFirstChild("TextBox")
            if not newBox then
                newBox = Instance.new("TextBox")
                newBox.Name = "TextBox"
                newBox.Size = UDim2.new(1, 0, 1, 0)
                newBox.Text = ""
                newBox.Visible = true
                newBox.ClearTextOnFocus = false
                newBox.Parent = typeFrame
            end
            return newBox
        end
    end
    
    return nil
end

