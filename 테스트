function NetworkManager.initializeDatabases()
    local function processLoad(cachePath, endpointUrl, targetTable)
        local loaded = false
        if type(readfile) == "function" and type(isfile) == "function" then
            if isfile(cachePath) then
                local decodeSuccess, decodedData = pcall(function()
                    return Services.HttpService:JSONDecode(readfile(cachePath))
                end)
                if decodeSuccess and type(decodedData) == "table" then
                    for key, val in pairs(decodedData) do
                        targetTable[key] = val
                    end
                    loaded = true
                end
            end
        end
        if not loaded then
            local rawData = NetworkManager.download(endpointUrl)
            if rawData then
                local decodeSuccess, decodedData = pcall(function()
                    return Services.HttpService:JSONDecode(rawData)
                end)
                if decodeSuccess and type(decodedData) == "table" then
                    for key, val in pairs(decodedData) do
                        targetTable[key] = val
                    end
                    if type(writefile) == "function" then
                        pcall(function() writefile(cachePath, rawData) end)
                    end
                end
            end
        end
    end
    processLoad(CACHE_FILES.DUEUM, ENDPOINTS.DUEUM_URL, Database.DUEUM)
    processLoad(CACHE_FILES.DICT, ENDPOINTS.DICT_URL, Database.DICT)
    processLoad(CACHE_FILES.OPENING_DICT, ENDPOINTS.OPENING_DICT_URL, Database.OPENING_DICT)
    processLoad(CACHE_FILES.ROUTES, ENDPOINTS.ROUTES_URL, Database.ROUTES)
    processLoad(CACHE_FILES.CERT, ENDPOINTS.CERT_URL, Database.CERTIFICATES)
    processLoad(CACHE_FILES.OPENERS, ENDPOINTS.OPENERS_URL, Database.OPENERS)
end

