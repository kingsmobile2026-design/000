local function selectBestWordAi(char)
local targets = getCompatibleChars(char)
local tier1, tier2, tier3, tier4 = {}, {}, {}, {}
local fallbackAll = {}
local uniqueCheck = {}

local function sortAndInsert(w)
if uniqueCheck[w] then return end
uniqueCheck[w] = true
table.insert(fallbackAll, w)
local wLen = utf8.len(w) or #w
if wLen >= 6 then
table.insert(tier1, w)
elseif checkIsKillWord(w) then
table.insert(tier2, w)
elseif checkIsChobanWord(w) then
table.insert(tier3, w)
else
table.insert(tier4, w)
end
end

for _, w in ipairs(WordDB) do
for _, target in ipairs(targets) do
if string.sub(w, 1, string.len(target)) == target then
sortAndInsert(w)
break
end
end
end

for _, target in ipairs(targets) do
if DICT and DICT[target] then
for _, w in ipairs(DICT[target]) do sortAndInsert(w) end
end
if OPENING_DICT and OPENING_DICT[target] then
for _, w in ipairs(OPENING_DICT[target]) do sortAndInsert(w) end
end
end

if not isUserPremium then
if #fallbackAll > 0 then return fallbackAll[math.random(1, #fallbackAll)] end
return nil
end

if #tier1 > 0 then return tier1[math.random(1, #tier1)] end
if #tier2 > 0 then return tier2[math.random(1, #tier2)] end
if #tier3 > 0 then return tier3[math.random(1, #tier3)] end
if #tier4 > 0 then return tier4[math.random(1, #tier4)] end
return nil
end

local function updateView(key)
for _, c in ipairs(scroll:GetChildren()) do
if c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end
end
if key == "" then return 0 end
local targets = getCompatibleChars(key)
local uniqueCheck = {}
local tempCollectedWords = {}

local function processWord(w)
if not uniqueCheck[w] then
uniqueCheck[w] = true
table.insert(tempCollectedWords, w)
end
end

for _, w in ipairs(WordDB) do
for _, target in ipairs(targets) do
if string.sub(w, 1, string.len(target)) == target then
processWord(w)
break
end
end
end

for _, target in ipairs(targets) do
if DICT and DICT[target] then
for _, w in ipairs(DICT[target]) do processWord(w) end
end
if OPENING_DICT and OPENING_DICT[target] then
for _, w in ipairs(OPENING_DICT[target]) do processWord(w) end
end
end

table.sort(tempCollectedWords, function(a, b)
local la, lb = utf8.len(a) or #a, utf8.len(b) or #b
if la ~= lb then return la > lb end
return a < b
end)

local visibleCount = 0
local totalCount = #tempCollectedWords
local limit = isUserPremium and totalCount or math.clamp(math.round(totalCount * 0.5), 1, 60)

for i, w in ipairs(tempCollectedWords) do
if i > limit then break end
createWordElement(w, i, false)
visibleCount = visibleCount + 1
end

if not isUserPremium and totalCount > visibleCount then
local lock = Instance.new("TextLabel", scroll)
lock.Size = UDim2.new(1, -4 * uiScale, 0, 24 * uiScale)
lock.BackgroundColor3 = Color3.fromRGB(45, 30, 30)
lock.Text = " 🔐 프리미엄 미등록 유저 단어 제한됨 (" .. (totalCount - visibleCount) .. "개 숨겨짐)"
