            if v.Name == "TextBox" or v.Name == "InputText" or v.Parent.Name == "TypeFrame" then
                return v
            end
        end
    end
    return nil
end

function AutomationManager.sendWordToGame(word, explicitBox)
    if word == "" then return end
    local targetBox = explicitBox or AutomationManager.forceInvokeTextBox()
    if not targetBox then return end

    AutomationManager.CurrentTypeSession = AutomationManager.CurrentTypeSession + 1
    local mySession = AutomationManager.CurrentTypeSession
    
    local speed = CONFIG.DEFAULT_TYPING_SPEED
    if InterfaceManager.SpeedInput then speed = tonumber(InterfaceManager.SpeedInput.Text) or CONFIG.DEFAULT_TYPING_SPEED end

    pcall(function()
        targetBox.Text = ""
        targetBox:CaptureFocus()
        if speed <= 0 then
            if mySession ~= AutomationManager.CurrentTypeSession then return end
            targetBox.Text = word
        else
            local totalStates = HangulEngine.buildTypeStates(word)
            local delayTime = 60 / (speed * 2.5)
            for _, partialText in ipairs(totalStates) do
                if mySession ~= AutomationManager.CurrentTypeSession then return end
                targetBox.Text = partialText
                task.wait(delayTime)
            end
        end
        if mySession ~= AutomationManager.CurrentTypeSession then return end
        task.wait(0.01)
        targetBox:ReleaseFocus(true)
        if SecurityManager.AntiCheatActive then
            task.wait(CONFIG.ANTI_CHEAT_POST_WAIT)
            if mySession == AutomationManager.CurrentTypeSession then targetBox.Text = "" end
        end
    end)
end

function AutomationManager.runChatSpam(msg, count)
    if msg == "" then return end
    task.spawn(function()
        for _ = 1, count do
            local sent = false
            if Services.TextChatService and Services.TextChatService.ChatInputBarConfiguration then
                local currentChannel = Services.TextChatService.ChatInputBarConfiguration.TargetTextChannel
                if currentChannel then currentChannel:SendAsync(msg) sent = true end
            end
            if not sent then
                local sayMessage = Services.ReplicatedStorage:FindFirstChild("SayMessageRequest", true) or (Services.ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents") and Services.ReplicatedStorage.DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest"))
                if sayMessage and sayMessage:IsA("RemoteEvent") then sayMessage:FireServer(msg, "All")
                else
                    local chatBar = LocalPlayer.PlayerGui:FindFirstChild("Chat") and LocalPlayer.PlayerGui.Chat:FindFirstChild("Frame") and LocalPlayer.PlayerGui.Chat.Frame:FindFirstChild("ChatBarParentFrame")
                    local realBar = chatBar and chatBar:FindFirstChild("Frame") and chatBar.Frame:FindFirstChild("BoxFrame") and chatBar.Frame.BoxFrame:FindFirstChild("ChatBar")
                    if realBar and realBar:IsA("TextBox") then realBar:CaptureFocus() realBar.Text = msg task.wait(0.05) realBar:ReleaseFocus(true) end
                end
            end
            task.wait(0.5)
        end
    end)
end

function AutomationManager.runGameSpam(msg, count)
    if msg == "" then return end
    local targetBox = AutomationManager.forceInvokeTextBox()
    if not targetBox then return end
    task.spawn(function()
        pcall(function()
            targetBox:CaptureFocus()
            for _ = 1, count do
                local totalStates = HangulEngine.buildTypeStates(msg)
                for _, partialText in ipairs(totalStates) do targetBox.Text = partialText task.wait(0.01) end
                task.wait(0.4) targetBox.Text = "" task.wait(0.3)
            end
            targetBox.Text = "" targetBox:ReleaseFocus(false)
        end)
    end)
end

function AutomationManager.runEmergencySpam()
    local targetBox = AutomationManager.forceInvokeTextBox()
    if not targetBox then return end
    task.spawn(function()
        for _ = 1, CONFIG.EMERGENCY_SPAM_COUNT do
            pcall(function() targetBox.Text = "" targetBox:CaptureFocus() targetBox.Text = "ㄴ" task.wait(0.01) targetBox:ReleaseFocus(true) end)
            task.wait(CONFIG.EMERGENCY_SPAM_INTERVAL)
        end
    end)
end

local IntelligentSearchScanner = {}
function IntelligentSearchScanner.begin()
    task.spawn(function()
        local previousInspectedText = ""
        while true do
            task.wait(0.1)
            local activeBox = AutomationManager.checkGameTextBoxActiveState()
            if activeBox then
                local rawString = activeBox.Text
                if rawString ~= "" and rawString ~= previousInspectedText then
                    previousInspectedText = rawString
                    local cleanChar = string.sub(rawString, 1, 3)
                    if InterfaceManager.SearchBox and InterfaceManager.SearchBox.Text ~= cleanChar then
                        InterfaceManager.SearchBox.Text = cleanChar
                    end
                end
            else
                previousInspectedText = ""
            end
        end
    end)
end

local StrategyExecutionLoop = {}
function StrategyExecutionLoop.begin()
    task.spawn(function()
        while true do
            task.wait(CONFIG.AI_LOOP_INTERVAL)
            if SecurityManager.BotAiActive then
                local activeBox = AutomationManager.checkGameTextBoxActiveState()
                if activeBox then
                    local currentGameText = activeBox.Text
                    if currentGameText ~= "" then
                        local firstChar = string.sub(currentGameText, 1, 3)
                        local compChars = StrategicCore.getCompatibleChars(firstChar)
                        local pool = {}
                        for _, c in ipairs(compChars) do
                            if Database.DICT[c] then
                                for _, word in ipairs(Database.DICT[c]) do table.insert(pool, word) end
                            end
                        end
                        if #pool > 0 then
                            table.sort(pool, function(a, b)
                                local priorityA = 0
                                local priorityB = 0
                                if StrategicCore.FirstTurnFlag then
                                    if StrategicCore.checkIsChobanWord(a) or StrategicCore.checkIsPerfectDefenseWord(a) then priorityA = priorityA + 100 end
                                    if StrategicCore.checkIsChobanWord(b) or StrategicCore.checkIsPerfectDefenseWord(b) then priorityB = priorityB + 100 end
                                end
                                if StrategicCore.checkIsUltraLongWord(a) then priorityA = priorityA + 50 end
                                if StrategicCore.checkIsUltraLongWord(b) then priorityB = priorityB + 50 end
                                if StrategicCore.checkIsPerfectKillWord(a) then priorityA = priorityA + 40
                                elseif StrategicCore.checkIsKillWord(a) then priorityA = priorityA + 30
                                elseif StrategicCore.checkIsPerfectDefenseWord(a) then priorityA = priorityA + 20
                                elseif StrategicCore.checkIsChobanWord(a) then priorityA = priorityA + 10 end
                                if StrategicCore.checkIsPerfectKillWord(b) then priorityB = priorityB + 40
                                elseif StrategicCore.checkIsKillWord(b) then priorityB = priorityB + 30
                                elseif StrategicCore.checkIsPerfectDefenseWord(b) then priorityB = priorityB + 20
                                elseif StrategicCore.checkIsChobanWord(b) then priorityB = priorityB + 10 end
                                if priorityA ~= priorityB then return priorityA > priorityB else return utf8.len(a) > utf8.len(b) end
                            end)
                            local selectedWord = pool[1]
                            if selectedWord then
                                AutomationManager.sendWordToGame(selectedWord, activeBox)
                                StrategicCore.FirstTurnFlag = false
                                SecurityManager.TurnToken = SecurityManager.TurnToken + 1
                                task.wait(CONFIG.AI_WORD_POST_WAIT)
                            end
                        end
                    end
                end
            end
        end
    end)
end

