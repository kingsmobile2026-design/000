----------------------------------------------------------------------
-- 10. Runtime loops
----------------------------------------------------------------------
local nextThrow = 0
local nextCatch = 0
local nextPickup = 0
local nextDodge = 0
local nextSkill = 0
local nextJoin = 0
local nextAfk = 0

state.thrownCount = 0
state.caughtCount = 0

local lastHoldState = false
local holdStartTime = 0

local function throwKeyCode()
	local value = flag("ThrowKey")
	if typeof(value) == "EnumItem" then
		return value
	end
	if type(value) == "string" then
		local ok, code = pcall(function()
			return Enum.KeyCode[value]
		end)
		if ok and code then
			return code
		end
	end
	return Enum.KeyCode.R
end

local holdThrowKey = false
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == throwKeyCode() then
		holdThrowKey = true
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == throwKeyCode() then
		holdThrowKey = false
	end
end)

UserInputService.JumpRequest:Connect(function()
	if flag("InfJump") then
		local humanoid = getHumanoid()
		if humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
end)

task.spawn(function()
	while isCurrentGeneration() do
		local now = os.clock()
		local inRound = isInRound()
		local alive = isAlive()
		local playing = GameState:GetAttribute("State") == "Playing"
		local holding = isHolder()

		if holding ~= lastHoldState then
			lastHoldState = holding
			if holding then
				holdStartTime = now
			end
		end

		local throwDelay = math.max(num("AutoThrowDelay", 0.15), 0)
		if flag("AutoThrow") and playing and inRound and alive and holding and (now - holdStartTime >= throwDelay) and now >= nextThrow then
			nextThrow = now + 0.3
			local target = bestTarget()
			if target then
				task.spawn(function()
					if throwAt(target) then
						state.thrownCount = (state.thrownCount or 0) + 1
						Log:Push("자동 → <Accent>" .. target.name .. "</Accent>")
					end
				end)
			end
		end

		if holdThrowKey and playing and inRound and alive and holding and (now - holdStartTime >= throwDelay) and now >= nextThrow then
			nextThrow = now + 0.3
			local target = bestTarget()
			if target then
				task.spawn(function()
					if throwAt(target) then
						state.thrownCount = (state.thrownCount or 0) + 1
					end
				end)
			end
		end

		-- [고정밀 자동 잡기 (Auto Catch) - 예측 강도 유지 및 판정 세분화]
		if flag("AutoCatch") and now >= nextCatch then
			local eta = ballEta()
			local ballDist = ballDistance()
			
			-- 판정 범위를 4.0 스터드로 촘촘하게 잡고, 공이 다가오는 상황에서 즉각 반응하도록 보강
			local isPreciseClose = ballDist and ballDist <= 4.0
			
			if (eta and eta <= math.max(num("CatchMargin", 0.15), 0.05)) or isPreciseClose then
				nextCatch = now + CATCH_COOLDOWN
				
				-- 0.008초 간격으로 5번 초고속 연사 전송하여 확실하게 캐치
				task.spawn(function()
					for i = 1, 5 do
						pcall(function()
							Remotes.RequestCatch:FireServer(eta or 0)
						end)
						task.wait(0.008)
					end
				end)
				
				state.caughtCount = (state.caughtCount or 0) + 1
				Log:Push("<Success>고정밀 잡기 성공! (5연사)</Success>")
			end
		end

		-- Auto pickup
		if flag("AutoPickup") and now >= nextPickup and GameState:GetAttribute("BallState") == "Loose" then
			local distance = ballDistance()
			if distance and distance <= num("PickupRadius", 25) then
				nextPickup = now + 0.3
				pcall(function()
					Remotes.RequestPickup:FireServer()
				end)
			end
		end

		-- Auto dodge
		if flag("AutoDodge") and now >= nextDodge and playing and alive then
			local eta, lateral = ballEta()
			if eta and eta <= 0.3 and (lateral or 99) <= CATCH_RADIUS + 8 then
				nextDodge = now + DODGE_COOLDOWN
				local anim = flag("DodgeAnim") or "D_Slide"
				if anim == "Default (auto)" then
					anim = "D_Dodge"
				end
				pcall(function()
					Remotes.RequestDodge:FireServer(anim)
				end)
			end
		end

		-- Auto skill
		if flag("AutoSkill") and now >= nextSkill and playing and alive and inRound then
			local skillName = LocalPlayer:GetAttribute("EquippedSkill") or "Dash"
			local skill = Config.Skills and Config.Skills[skillName]
			local cooldown = skill and skill.Cooldown or 12
			nextSkill = now + cooldown
			pcall(function()
				Remotes.RequestSkill:FireServer()
			end)
		end

		-- Auto join
		if flag("AutoJoin") and GameState:GetAttribute("State") ~= "Playing" and not inRound and now >= nextJoin then
			nextJoin = now + 4
			pcall(function()
				Remotes.RequestJoin:FireServer()
			end)
			Log:Push("다음 라운드 참가 완료")
		end

		-- Anti-AFK
		if flag("AntiAfk") and now >= nextAfk then
			nextAfk = now + 25
			local humanoid = getHumanoid()
			local root = getRoot()
			if humanoid and root then
				local direction = Vector3.new(math.random(-1, 1), 0, math.random(-1, 1))
				if direction.Magnitude < 0.1 then
					direction = Vector3.new(1, 0, 0)
				end
				humanoid:Move(direction.Unit, false)
				task.wait(0.4)
				humanoid:Move(Vector3.zero, false)
			end
		end

		local humanoid = getHumanoid()
		if humanoid then
			if flag("SpeedEnabled") then
				local speed = num("WalkSpeed", 30)
				if humanoid.WalkSpeed ~= speed then
					humanoid.WalkSpeed = speed
				end
			end
			if flag("JumpEnabled") then
				local power = num("JumpPower", 50)
				if humanoid.JumpPower ~= power then
					humanoid.JumpPower = power
				end
			end
		end

		task.wait(0.05)
	end
end)

task.spawn(function()
	while isCurrentGeneration() do
		local ok, err = pcall(function()
			updateEsp()
			updateBallEsp()
		end)
		if not ok then
			warn("[WHITES_HUB] ESP:", tostring(err))
			Log:Push("<Error>ESP: " .. tostring(err) .. "</Error>")
			task.wait(2)
		end
		task.wait(0.12)
	end
end)

