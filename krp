local function getCharacter()
	return LocalPlayer.Character
end

local function getRoot()
	local character = getCharacter()
	if not character then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
	local character = getCharacter()
	if not character then
		return nil
	end
	return character:FindFirstChildOfClass("Humanoid")
end

local function isInRound()
	return LocalPlayer:GetAttribute("InRound") == true
end

local function isAlive()
	return LocalPlayer:GetAttribute("Alive") == true
end

local function isHolder()
	return GameState:GetAttribute("HolderId") == LocalPlayer.UserId
end

local function collectTargets()
	local list = {}
	local myCharacter = getCharacter()
	for _, model in ipairs(Workspace:GetChildren()) do
		if model:IsA("Model") and model ~= myCharacter and model:GetAttribute("InGame") == true then
			local root = model:FindFirstChild("HumanoidRootPart")
			if root then
				local player = Players:GetPlayerFromCharacter(model)
				local userId = 0
				if player then
					userId = player.UserId
				else
					local botIndex = model.Name:match("^봇(%d+)$")
					if botIndex then
						userId = -tonumber(botIndex)
					end
				end

				local hp = 0
				local coins = 0
				local rankRP = 0
				local alive = true
				if player then
					hp = player:GetAttribute("HP") or 0
					coins = player:GetAttribute("Coins") or 0
					rankRP = player:GetAttribute("RankRP") or 0
					local attr = player:GetAttribute("Alive")
					alive = attr == nil and true or attr == true
				end

				list[#list + 1] = {
					model = model,
					root = root,
					player = player,
					name = player and player.DisplayName or model.Name,
					userId = userId,
					hp = hp,
					coins = coins,
					rankRP = rankRP,
					alive = alive,
				}
			end
		end
	end
	return list
end

-- [개선] 화면(OnScreen) 안에 들어온 사람 중에서만 가장 가까운 사람 타겟팅
local function bestTarget()
	local root = getRoot()
	if not root then
		return nil
	end

	local camera = Workspace.CurrentCamera
	if not camera then return nil end

	local myPosition = root.Position
	local maxRange = num("AimFOV", 0)
	local priority = flag("TargetPriority") or "Nearest"
	local best, bestScore = nil, math.huge

	for _, target in ipairs(collectTargets()) do
		if target.alive then
			-- 카메라 화면에 들어와 있는지(OnScreen) 체크
			local _, onScreen = camera:WorldToViewportPoint(target.root.Position)
			if onScreen then
				local distance = (target.root.Position - myPosition).Magnitude
				local inRange = maxRange <= 0 or distance <= maxRange
				if inRange and distance > 1 then
					local score = distance
					if priority == "Lowest HP" then
						score = target.hp
					elseif priority == "Most RP" then
						score = -target.rankRP
					elseif priority == "Most Coins" then
						score = -target.coins
					elseif priority == "Ball Holder (threat)" then
						score = (GameState:GetAttribute("HolderId") == target.userId) and -1 or distance
					end

					if score < bestScore then
						bestScore, best = score, target
					end
				end
			end
		end
	end

	return best
end

local function throwAt(target)
	local root = getRoot()
	if not (root and target) then
		return false, "대상이 없습니다"
	end
	if GameState:GetAttribute("State") ~= "Playing" then
		return false, "라운드 중이 아닙니다"
	end
	if not isHolder() then
		return false, "공을 들고 있지 않습니다"
	end

	local delta = Vector3.new(
		target.root.Position.X - root.Position.X,
		0,
		target.root.Position.Z - root.Position.Z
	)
	if delta.Magnitude < 1 then
		return false, "대상이 너무 가깝습니다"
	end

	local mode = flag("PowerMode") or "Perfect"
	local power = 1
	if mode == "Fixed" then
		power = num("PowerValue", 1)
	elseif mode == "Random" then
		power = 0.55 + math.random() * 0.45
	end
	power = math.clamp(power, 0, 1)

	local curve = num("ThrowCurve", 0)
	curve = math.clamp(curve, -1, 1)

	Remotes.RequestCharge:FireServer(true)
	task.wait(0.04)
	Remotes.RequestThrow:FireServer(power, delta.Unit, curve, target.userId)

	return true
end

local function ballEta()
	if GameState:GetAttribute("BallState") ~= "Live" then
		return nil
	end

	local ball = Workspace:FindFirstChild("DodgeBall")
	local root = getRoot()
	if not (ball and root) then
		return nil
	end

	local velocity = ball.AssemblyLinearVelocity
	local flat = Vector3.new(velocity.X, 0, velocity.Z)
	local speed = flat.Magnitude
	if speed < 20 then
		return nil
	end

	local direction = flat / speed
	local toMe = Vector3.new(
		root.Position.X - ball.Position.X,
		0,
		root.Position.Z - ball.Position.Z
	)
	local along = toMe:Dot(direction)
	local lateral = (toMe - direction * along).Magnitude

	if along < -1 then
		return nil
	end
	if lateral > CATCH_RADIUS + 6 then
		return nil
	end

	return math.max(along - CATCH_RADIUS, 0) / speed, lateral, along
end

local function ballDistance()
	local ball = Workspace:FindFirstChild("DodgeBall")
	local root = getRoot()
	if not (ball and root) then
		return nil
	end
	return (ball.Position - root.Position).Magnitude
end

